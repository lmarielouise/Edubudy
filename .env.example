# ─────────────────────────────────────────────
# Edubudy — Variables d'environnement Vercel
# Copiez ce fichier en .env.local pour le dev
# ─────────────────────────────────────────────

# Anthropic (Claude) — requis pour le chat et la détection de sécurité
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini — requis pour la transcription vocale (GRATUIT jusqu'à 1500 req/jour)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Neon PostgreSQL — requis pour stocker les alertes parents
# https://console.neon.tech → New Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/edubudy?sslmode=require

# Secret partagé entre l'app mobile et le serveur (générez une chaîne aléatoire longue)
# Exemple : openssl rand -hex 32
API_SECRET=mon-super-secret-aleatoire-tres-long

# Profil de l'enfant
CHILD_NAME=Prénom
CHILD_AGE=10
# Niveau scolaire : CP | CE1 | CE2 | CM1 | CM2 | 6eme | 5eme | 4eme | 3eme | 2nde | 1ere | Terminale
CHILD_SCHOOL_LEVEL=CM2

# PIN d'accès au tableau de bord parent (chiffres uniquement, 4 min.)
PARENT_PIN=1234

# Personnalisation (optionnel)
# Mascotte : owl | robot | star | cat
MASCOT=owl
# Thème : blue | green | purple | orange
THEME=blue
VOICE_SPEED=0.9
ENABLE_VOICE_RESPONSE=true
# Matières à renforcer (séparées par virgule)
SUBJECTS_OF_FOCUS=

# Notifications email (optionnel)
PARENT_EMAIL=parent@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Edubudy <your_email@gmail.com>

# Webhook d'alerte optionnel (Pushover, Slack, ntfy…)
ALERT_WEBHOOK_URL=
