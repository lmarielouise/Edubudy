# Anthropic API Key (required)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Child Profile
CHILD_NAME=Prénom
CHILD_AGE=10
# School level: CP | CE1 | CE2 | CM1 | CM2 | 6eme | 5eme | 4eme | 3eme | 2nde | 1ere | Terminale
CHILD_SCHOOL_LEVEL=CM2

# Parent Notifications
PARENT_EMAIL=parent@example.com
# PIN to access parent dashboard (digits only)
PARENT_PIN=1234

# Email SMTP (for alert notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Edubudy <your_email@gmail.com>

# Optional: Webhook URL for push notifications (Pushover, Slack, etc.)
ALERT_WEBHOOK_URL=
